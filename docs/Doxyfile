HTML_EXTRA_STYLESHEET   = docs/doxygen-custom.css
HTML_DYNAMIC_MENUS      = YES
HTML_DYNAMIC_SECTIONS   = YES
HTML_INDEX_NUM_ENTRIES  = 100

# Render mathematical formulas with MathJax instead of generating form_*.png
# bitmap files. This keeps the Windows/GitHub Pages documentation build free
# from an external LaTeX/Ghostscript toolchain and prevents broken formula
# assets from being published.
USE_MATHJAX             = YES
MATHJAX_VERSION         = MathJax_3
MATHJAX_FORMAT          = SVG
MATHJAX_RELPATH         = https://cdn.jsdelivr.net/npm/mathjax@3

DISABLE_INDEX           = YES
