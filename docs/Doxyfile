# ULSAlgorithms - Doxygen configuration
# Design target: Doxygen 1.17.0
DOXYFILE_ENCODING       = UTF-8
OUTPUT_LANGUAGE         = English

PROJECT_NAME            = "ULSAlgorithms"
PROJECT_NUMBER          = "generated-by-build-script"
PROJECT_BRIEF           = "High-performance exact and heuristic algorithms for uncapacitated lot sizing"
PROJECT_LOGO            = docs/assets/ulsalgorithms-doxygen-logo.png
PROJECT_ICON            = docs/assets/algorithms-icon-32.png

CREATE_SUBDIRS          = NO
ALLOW_UNICODE_NAMES     = YES
FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = .
SHORT_NAMES             = NO

BRIEF_MEMBER_DESC       = YES
REPEAT_BRIEF            = YES
INHERIT_DOCS            = YES
SEPARATE_MEMBER_PAGES   = NO

MARKDOWN_SUPPORT        = YES
MARKDOWN_STRICT         = YES
MARKDOWN_ID_STYLE       = GITHUB
AUTOLINK_SUPPORT        = YES
AUTOLINK_IGNORE_WORDS   = ULSAlgorithms
TOC_INCLUDE_HEADINGS    = 4

EXTENSION_MAPPING       = cs=Csharp
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = NO
EXTRACT_PACKAGE         = YES
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
HIDE_UNDOC_NAMESPACES   = NO
SHOW_HEADERFILE         = NO
SHOW_INCLUDE_FILES      = NO
SHOW_USED_FILES         = YES
