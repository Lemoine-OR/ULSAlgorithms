<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ULSAlgorithms</AssemblyName>
    <RootNamespace>ULSAlgorithms</RootNamespace>
    <PackageId>ULSAlgorithms</PackageId>
    <IsPackable>true</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>High-performance C# algorithms and formulations for the uncapacitated lot-sizing problem (ULS).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>operations-research;lot-sizing;optimization;dynamic-programming;heuristics</PackageTags>

    <!-- Official .NET package validation runs after Pack. The released 1.0.0
         package can later become PackageValidationBaselineVersion for 1.x. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- .NET 8+ SDKs include Source Link build tooling. Publish portable
         symbols as a modern NuGet .snupkg without adding a Source Link package
         dependency to the product. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\CITATION.cff" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
